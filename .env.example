# Copy this to `.env`, fill in the real values, and `source .env` before a demo.
# `.env` is gitignored; this template is not. See harness/slack/SETUP.md for where
# each value comes from.

# --- Slack (the SIEM/SOAR bot) ---
# Bot User OAuth Token from the app created via harness/slack/manifest.yaml (xoxb-...)
export SLACK_BOT_TOKEN=
# The public demo channel id (C...), with the bot invited to it.
export SLACK_CHANNEL=

# --- Product API (launching the harness) ---
# Base URL of the Serverless product.
export SERVERLESS_API_URL=https://app.getserverless.ai
# API client credential owned by a user holding harness:create + configuration:use.
export SERVERLESS_CLIENT_ID=
export SERVERLESS_CLIENT_SECRET=
# The soc-triage template's configuration id.
export SOC_TRIAGE_CONFIG_ID=
# The frame's slack-thread parameter name (must match frame.yaml; default "thread").
export SOC_TRIAGE_THREAD_PARAM=thread

# --- The launch bridge (bot serve) ---
# Signs the button's launch token. Not a credential -- any random value, kept
# stable while `bot serve` runs. Generate once: openssl rand -hex 32
export BOT_SIGNING_SECRET=
# The tunnel URL the button points at, from `ngrok http 8787`. Changes per session.
export BOT_PUBLIC_URL=
