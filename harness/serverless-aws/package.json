{
  "name": "@rcx24/serverless-aws",
  "version": "0.1.0",
  "description": "Serverless AI \u2014 read-only AWS investigation CLI. Reads credentials a connector delivered; makes no changes.",
  "bin": {
    "serverless-aws": "dist/serverless-aws.cjs"
  },
  "type": "module",
  "scripts": {
    "build": "esbuild src/serverless-aws.mjs --bundle --platform=node --format=cjs --outfile=dist/serverless-aws.cjs --banner:js='#!/usr/bin/env node'",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.600.0",
    "@aws-sdk/client-iam": "^3.600.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.600.0",
    "@aws-sdk/credential-providers": "^3.600.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
