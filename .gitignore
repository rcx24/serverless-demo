# Terraform
.terraform/
.terraform.lock.hcl
tfplan
*.tfstate
*.tfstate.*
crash.log

# Variable files hold account ids and the connector's external id. The two
# exceptions below are committed on purpose: `account.auto.tfvars` is written by
# the org apply and read by the demo root, and without it in git the next person
# to clone this cannot plan at all. Neither file holds a secret -- an account id
# is not one, and the external id is a replay guard that only has meaning
# alongside a credential that is not here.
*.tfvars
!terraform/environments/*/account.auto.tfvars
!terraform/environments/*/connector.auto.tfvars
!terraform/org/accounts.auto.tfvars

# Per-run output, regenerated by every seed and never committed. The three JSON
# bundles are reproducible from a seed run; how they reach the harness (Slack, or
# a copy into the runbooks repo) is the delivery step's job, not this repo's git
# history.
artifacts/

# Python
.venv/

# Live demo secrets: the API client secret, the Slack bot token, the bot signing
# secret, the tunnel URL. Never committed. Copy .env.example to .env and fill it in.
.env
!.env.example
__pycache__/
*.egg-info/
.pytest_cache/

# Node (investigator build output, if built here rather than in the runbooks repo)
node_modules/
dist/

.DS_Store

# Answer keys and raw run output. answer-key.md names exactly what the analyst is
# supposed to find, so it must never reach the harness or the repository.
out/

# sdemo build output and deps. The bundle is published to npm, and the harness
# installs it from there via the tool catalog -- it is not committed here.
harness/serverless-aws/dist/
harness/serverless-aws/node_modules/
